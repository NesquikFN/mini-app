PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Postgres connection string (Railway → Postgres service → Connect).
# Locally, tunnel with: railway connect Postgres --tunnel-only --port 15432
DATABASE_URL=

# Disk for uploaded images — a Railway Volume in production, any local
# folder for dev. PUBLIC_URL builds the full image URL served from it.
UPLOADS_DIR=uploads
PUBLIC_URL=http://localhost:3000

# Telegram Bot API → BotFather → /mybots → your bot → API Token
# Never expose this to the frontend or commit it to Git.
BOT_TOKEN=

# Signs the session tokens issued after Telegram authentication.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Dev-only bypass: when true AND NODE_ENV!=production, POST /api/auth/telegram
# accepts requests with no initData and issues a session for a fixed dev
# profile, so the frontend can be developed without a real Telegram client.
# Ignored by the code whenever NODE_ENV=production, regardless of this value.
DEV_AUTH=false

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Supabase → Project Settings → API
# SUPABASE_URL: поле "Project URL"
# SUPABASE_SERVICE_ROLE_KEY: поле "service_role" (секрет!) у розділі "Project API keys"
# Ніколи не передавайте SUPABASE_SERVICE_ROLE_KEY у frontend і не комітьте його в Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:security && npm run test:integration",
    "test:unit": "tsx --test \"src/services/*.test.ts\" \"src/validation/*.test.ts\"",
    "test:security": "tsx --test \"src/__security__/*.test.ts\"",
    "test:integration": "BOT_TOKEN=integration-test-bot-token-do-not-use-in-prod tsx --test \"src/__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
